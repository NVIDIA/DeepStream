# Sample Dockerfile for a DeepStream TAO ds_app-style pipeline on Tegra
# (Jetson), using a Triton-enabled DeepStream base image and a PyTorch
# source image for copying Python packages for aarch64.
#
# Target platform: aarch64 / NVIDIA Tegra (Jetson)
# Intended for Jetson devices (e.g. Orin, AGX Orin, Thor) running JetPack /
# Tegra Linux. PyTorch and related packages are copied from the NGC
# pytorch image rather than installed via pip, since Tegra-compatible
# wheels are not available on the standard PyTorch index.
FROM "nvcr.io/nvidia/pytorch:25.08-py3" AS pytorch_src

# Pull the base image from Deepstream Triton multiarch image.
FROM gitlab-master.nvidia.com:5005/deepstreamsdk/release_image/deepstream:9.1.1-26.08.2-triton-20260817-ma-dev99 AS inference_base

RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends libyaml-cpp-dev pkg-config cmake

RUN --mount=type=bind,from=pytorch_src,source=/usr/local/lib/python3.12/dist-packages,target=/tmp/pytorch_src \
    cp -r /tmp/pytorch_src/{torch,functorch,torchgen,torch-*,torchvision*,flash_attn*,tensorrt*} \
    /usr/local/lib/python3.12/dist-packages/ && \
    cp -r /tmp/pytorch_src/triton /usr/local/lib/python3.12/dist-packages/ && \
    sed -i '/self.capability = target.arch/a\        if self.capability == 121: self.capability = 120' /usr/local/lib/python3.12/dist-packages/triton/backends/nvidia/compiler.py
COPY --from=pytorch_src /usr/local/lib/libnvpl* /usr/local/lib/


RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    jinja2==3.1.6 \
    omegaconf==2.3.0 \
    networkx==3.5 \
    sympy==1.14.0 \
    pillow==11.3 \
    transformers==4.54.1 \
    opencv-python==4.11.0.86

ARG CUDA_VERSION_MAJOR=13
ARG CUDA_VERSION_MINOR=2
ARG CUDA_VERSION_PATCH=75
ARG CUDA_VERSION_BUILD=0
ARG CUDA_VERSION_MAJOR_MINOR=$CUDA_VERSION_MAJOR.$CUDA_VERSION_MINOR
ARG CUDA_VERSION_FULL=$CUDA_VERSION_MAJOR_MINOR.$CUDA_VERSION_PATCH.$CUDA_VERSION_BUILD

WORKDIR /tmp

# TensorRT OSS build is disabled by default. The DeepStream 9.1 base image
# already includes TensorRT plugin/parser libraries and trtexec.
# Enable the TensorRT OSS build if specific operators required by a model are missing.
# To re-enable, uncomment and update the block below as needed.
# ARG TRT_VERSION_MAJOR=10
# ARG TRT_VERSION_MINOR=13
# ARG TRT_VERSION_PATCH=0
# ARG TRT_VERSION_BUILD=0
#
# ARG TRT_VERSION_MAJOR_MINOR=$TRT_VERSION_MAJOR.$TRT_VERSION_MINOR
# ARG TRT_VERSION_MAJOR_MINOR_PATCH=$TRT_VERSION_MAJOR.$TRT_VERSION_MINOR.$TRT_VERSION_PATCH
# ARG TRT_VERSION_FULL=$TRT_VERSION_MAJOR_MINOR_PATCH.$TRT_VERSION_BUILD
# ARG CUDNN_VERSION=9.12.0.46-1
#
# ENV TRT_VERSION=$TRT_VERSION_FULL+cuda$CUDA_VERSION_FULL
# ENV TRT_TAG="release/$TRT_VERSION_MAJOR_MINOR"
# RUN mkdir trt_oss_src && \
#     cd trt_oss_src && \
#     echo "$PWD Building TRT OSS..." && \
#     git clone -b $TRT_TAG https://github.com/nvidia/TensorRT TensorRT && \
#     cd TensorRT && \
#     git submodule update --init --recursive && \
#     mkdir -p build && cd build && \
#     cmake .. \
#     -DGPU_ARCHS="110;120;121" \
#     -DTRT_LIB_DIR=/usr/lib/aarch64-linux-gnu \
#     -DTRT_OUT_DIR=/tmp/out \
#     -DCUDA_VERSION=$CUDA_VERSION_MAJOR_MINOR \
#     -DCUDNN_VERSION=$CUDNN_VERSION \
#     -DCMAKE_C_COMPILER=/usr/bin/gcc \
#     && for i in {1..50}; do make -j 12 && break; done
# RUN echo "Listing /tmp/out:" && ls -l /tmp/out/libnvinfer_plugin.so.*
# RUN cp /tmp/out/libnvinfer_plugin.so.$TRT_VERSION_MAJOR_MINOR_PATCH /usr/lib/aarch64-linux-gnu/libnvinfer_plugin.so.$TRT_VERSION_MAJOR_MINOR_PATCH && \
#     cp /tmp/out/libnvinfer_plugin_static.a /usr/lib/aarch64-linux-gnu/libnvinfer_plugin_static.a && \
#     cp /tmp/out/libnvonnxparser.so.$TRT_VERSION_MAJOR_MINOR_PATCH /usr/lib/aarch64-linux-gnu/libnvonnxparser.so.$TRT_VERSION_MAJOR_MINOR_PATCH && \
#     cp /tmp/out/trtexec /usr/local/bin/ && \
#     cd ../../../ && \
#     rm -rf trt_oss_src


# Build DeepStream TAO app post-processors. This must come AFTER the
# DeepStream SDK is installed in the base image. The resulting
# libnvds_infercustomparser_tao.so is copied into the DeepStream lib
# directory for use by ds_app pipelines. Adjust the repo/tag or CUDA
# version if you use different DS/TAO releases.
ENV DS_TAO_APPS_REPO=https://github.com/NVIDIA-AI-IOT/deepstream_tao_apps.git
ENV DS_TAO_APPS_TAG="master"
ENV DS_SRC_PATH=/opt/nvidia/deepstream/deepstream
ARG CACHE_BUSTER=unique_value_to_bypass_docker_cache
RUN mkdir ds_tao_apps_src && \
   cd ds_tao_apps_src && \
   echo "$PWD Pulling DS TAO apps repo..." && \
   git clone -b $DS_TAO_APPS_TAG $DS_TAO_APPS_REPO ds_tao_apps && \
   cd ds_tao_apps/post_processor && \
   echo "$PWD Building DS TAO apps post processing..." && \
   CUDA_MODULE_LOADING=LAZY CUDA_VER=$CUDA_VERSION_MAJOR_MINOR make DS_SRC_PATH=$DS_SRC_PATH && \
   [ -f libnvds_infercustomparser_tao.so ] && echo "$PWD post processing build successful" || echo "$PWD post processing build falied" && \
   cp libnvds_infercustomparser_tao.so /opt/nvidia/deepstream/deepstream/lib && \
   cd ../../../ && \
   rm -rf ds_tao_apps_src

WORKDIR /workspace

# Copy the inference flow package generated by Inference Builder.
# This tarball (here: deepstream-app.tgz) is typically produced when
# running the builder with tarball output enabled, and its name should
# match the generated pipeline artifact you want to deploy.
ADD deepstream-app.tgz /workspace

# Copy test data for CI/regression testing of this sample pipeline.
# This is optional and specific to the ds_app sample setup.
COPY test_data/* /workspace/test_data/

## Set Environment variables required for DeepStream runtime.
# Make sure DeepStream GStreamer plugins and libraries are discoverable.
ENV GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins
# DS 26.05.2 added a system UCX package whose libucs.so.0 is an older build
# that lacks ucs_config_doc_nop — a symbol required by hpcx libucc.so.1 at
# torch import time. DS 26.04.1 had no system UCX, so the hpcx UCX (which has
# the symbol) was always used. Prepend hpcx UCX to LD_LIBRARY_PATH so the
# internally-consistent hpcx UCX takes precedence over the system package.
ENV LD_LIBRARY_PATH=/opt/hpcx/ucx/lib:/opt/hpcx/ucc/lib:/opt/nvidia/deepstream/deepstream/lib:$LD_LIBRARY_PATH
# Enable adaptive batching in nvstreammux for better GPU utilization.
ENV NVSTREAMMUX_ADAPTIVE_BATCHING=yes
# Optional: enable detailed latency measurement if needed.
#ENV NVDS_ENABLE_LATENCY_MEASUREMENT=1
#ENV NVDS_ENABLE_COMPONENT_LATENCY_MEASUREMENT=1

ENTRYPOINT ["/bin/bash", "-c", "ulimit -Sn $(ulimit -Hn); exec python3 /workspace/__main__.py \"$@\"", "--"]
#ENTRYPOINT ["/bin/bash"]
CMD []
