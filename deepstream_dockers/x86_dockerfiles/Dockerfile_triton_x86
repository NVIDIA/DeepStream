# open telemetry
# Built from source instead of prebuilt .deb packages: the Debian/Ubuntu archives
# rotate opentelemetry-cpp binaries out of the pool, which breaks the docker build.
# Runs after the protobuf step so the OTLP exporters link against the same protobuf
# the image ships. Default OTELCPP_VERSIONED_LIBS=OFF and WITH_STL=OFF are required:
# prebuilt DeepStream libraries expect unversioned SONAMEs
# (libopentelemetry_metrics.so) and the nostd ABI used by includes/opentelemetry.
# Do not add libcurl4-openssl-dev here: it conflicts with the libcurl4-gnutls-dev
# installed above, which already satisfies the exporter's CURL dependency.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      cmake \
      libgrpc++-dev \
      nlohmann-json3-dev \
      protobuf-compiler-grpc && \
    git clone --depth 1 --branch ${OPENTELEMETRY_CPP_VERSION} \
      https://github.com/open-telemetry/opentelemetry-cpp.git /tmp/opentelemetry-cpp && \
    git -C /tmp/opentelemetry-cpp submodule update --init --depth 1 third_party/opentelemetry-proto && \
    cmake -S /tmp/opentelemetry-cpp -B /tmp/opentelemetry-cpp/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib/x86_64-linux-gnu \
      -DCMAKE_CXX_STANDARD=17 \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DBUILD_SHARED_LIBS=ON \
      -DOPENTELEMETRY_INSTALL=ON \
      -DWITH_OTLP_HTTP=ON \
      -DWITH_OTLP_GRPC=ON \
      -DWITH_EXAMPLES=OFF \
      -DWITH_FUNC_TESTS=OFF \
      -DWITH_BENCHMARK=OFF \
      -DBUILD_TESTING=OFF && \
    cmake --build /tmp/opentelemetry-cpp/build \
      --parallel "${OPENTELEMETRY_BUILD_JOBS:-$(nproc)}" && \
    cmake --install /tmp/opentelemetry-cpp/build && \
    rm -rf /tmp/opentelemetry-cpp && \
    rm -rf /var/lib/apt/lists/* && \
    ldconfig

# Keep Ubuntu's /usr/bin/protoc and 3.21.12 libraries for the auxiliary OTEL
# build above. DeepStream's selected Triton SDK needs its own matching compiler.
RUN set -eu; \
    proto_header=/opt/tritonclient/include/google/protobuf/stubs/common.h; \
    test -f "$proto_header" || { echo 'ERROR: selected Triton protobuf version header is missing.' >&2; exit 1; }; \
    proto_code="$(awk '$2 == "GOOGLE_PROTOBUF_VERSION" && $3 ~ /^[0-9]+$/ { print $3; exit }' "$proto_header")"; \
    if [ "$proto_code" != 6033005 ]; then echo "ERROR: pinned protoc 33.5 requires Triton protobuf header code 6033005; found ${proto_code:-unknown}." >&2; exit 1; fi; \
    proto_tmp="$(mktemp -d /tmp/deepstream-protoc.XXXXXXXX)"; \
    trap 'rm -rf -- "$proto_tmp"' EXIT; \
    wget -nv -O "$proto_tmp/protoc.zip" https://github.com/protocolbuffers/protobuf/releases/download/v33.5/protoc-33.5-linux-x86_64.zip; \
    printf '%s  %s\n' 24e58fb231d50306ee28491f33a170301e99540f7e29ca461e0e80fd1239f8d1 "$proto_tmp/protoc.zip" | sha256sum -c -; \
    unzip -q "$proto_tmp/protoc.zip" -d "$proto_tmp/unpacked"; \
    test "$("$proto_tmp/unpacked/bin/protoc" --version)" = 'libprotoc 33.5'; \
    mkdir -p /opt/proto/bin /opt/proto/include; \
    rm -f /opt/proto/bin/protoc; \
    install -m 0755 "$proto_tmp/unpacked/bin/protoc" /opt/proto/bin/protoc; \
    cp -a "$proto_tmp/unpacked/include/." /opt/proto/include/; \
    test "$(/opt/proto/bin/protoc --version)" = 'libprotoc 33.5'

