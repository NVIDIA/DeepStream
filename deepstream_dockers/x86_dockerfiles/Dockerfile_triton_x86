# Static Triton client-symbol subset guard; no library loading or GPU execution.
# Exact mangled-name availability is not full ABI or runtime qualification.
# Modern providers require marked private static ownership; legacy shared clients
# retain the nonempty exact-import subset check below.
RUN set -eu; export LC_ALL=C; \
    abi_tmp="$(mktemp -d /tmp/deepstream-client-abi.XXXXXXXX)"; \
    trap 'rm -rf -- "$abi_tmp"' EXIT; \
    core=/opt/nvidia/deepstream/deepstream/lib/libnvds_infer_server.so; \
    client=/opt/tritonclient/lib/libgrpcclient.so; \
    proto_header=/opt/tritonclient/include/google/protobuf/stubs/common.h; \
    proto_code="$(awk '$2 == "GOOGLE_PROTOBUF_VERSION" && $3 ~ /^[0-9]+$/ { print $3; exit }' "$proto_header")"; \
    case "$proto_code" in ''|*[!0-9]*) echo 'ERROR: cannot identify selected Triton protobuf headers.' >&2; exit 1 ;; esac; \
    readelf -h "$core" > "$abi_tmp/core-header"; \
    readelf -h "$client" > "$abi_tmp/client-header"; \
    grep -Eq 'Class:[[:space:]]+ELF64' "$abi_tmp/core-header"; \
    grep -Eq 'Type:[[:space:]]+DYN' "$abi_tmp/core-header"; \
    core_machine="$(awk -F: '/Machine:/ { sub(/^[[:space:]]*/, "", $2); print $2 }' "$abi_tmp/core-header")"; \
    client_machine="$(awk -F: '/Machine:/ { sub(/^[[:space:]]*/, "", $2); print $2 }' "$abi_tmp/client-header")"; \
    test -n "$core_machine" && test "$core_machine" = "$client_machine"; \
    nm -D --undefined-only --format=posix "$core" > "$abi_tmp/undefined"; \
    nm -D -g --defined-only --format=posix "$core" > "$abi_tmp/core-defined"; \
    awk '$1 == "nvds_inferserver_static_protobuf_version" { print $2, $3 }' "$abi_tmp/core-defined" > "$abi_tmp/marker"; \
    if [ "$proto_code" -ge 6000000 ]; then \
        expected_marker="A $(printf '%x' "$proto_code")"; \
        if [ "$(cat "$abi_tmp/marker")" != "$expected_marker" ]; then \
            echo 'ERROR: modern Triton requires a version-matched static-owned SDK core; absent or mismatched ELF marker.' >&2; exit 1; \
        fi; \
        for symbol in \
            createInferTrtISContext createInferTritonGrpcContext validateInferConfigStr \
            _ZN15nvdsinferserver18parsePluginControlERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEERNS_6config13PluginControlE \
            _ZN15nvdsinferserver20parseInferenceConfigERKNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEERNS_6config15InferenceConfigE \
            _ZN15nvdsinferserver21formatInferenceConfigERKNS_6config15InferenceConfigERNSt7__cxx1112basic_stringIcSt11char_traitsIcESaIcEEE \
            _ZN15nvdsinferserver23findSpecificClassFilterERKNS_6config36PluginControl_OutputDetectionControlEj \
            _ZN15nvdsinferserver6config13PluginControlC1EPN6google8protobuf5ArenaE \
            _ZN15nvdsinferserver6config15InferenceConfigC1EPN6google8protobuf5ArenaE; do \
            if ! awk -v symbol="$symbol" '$1 == symbol && $2 == "T" { found=1 } END { exit !found }' "$abi_tmp/core-defined"; then \
                echo "ERROR: static-owned SDK core lacks required real typed/context export: $symbol" >&2; exit 1; \
            fi; \
        done; \
        for symbol in descriptor_table_nvdsinferserver_5fcommon_2eproto descriptor_table_nvdsinferserver_5fconfig_2eproto descriptor_table_nvdsinferserver_5fplugin_2eproto; do \
            if ! awk -v symbol="$symbol" '$1 == symbol && $2 == "D" && $4 !~ /^0*$/ && $4 != "" { found=1 } END { exit !found }' "$abi_tmp/core-defined"; then \
                echo "ERROR: static-owned SDK core lacks its nonempty generated schema: $symbol" >&2; exit 1; \
            fi; \
        done; \
        for symbol in TRITONSERVER_ServerNew TRITONSERVER_ServerInferAsync TRITONSERVER_ServerModelConfig; do \
            if ! awk -v symbol="$symbol" '$1 == symbol && $2 == "U" { found=1 } END { exit !found }' "$abi_tmp/undefined"; then \
                echo "ERROR: static-owned SDK core lacks required server C-API import: $symbol" >&2; exit 1; \
            fi; \
        done; \
        readelf -d "$core" > "$abi_tmp/dynamic"; \
        awk '/\(NEEDED\)/ { line=$0; sub(/^.*\[/, "", line); sub(/\].*$/, "", line); print line }' "$abi_tmp/dynamic" > "$abi_tmp/needed"; \
        grep -Fx 'libtritonserver.so' "$abi_tmp/needed" > /dev/null; \
        if grep -E '^lib(grpc|gpr|protobuf|absl|upb|utf8|re2|cares|address_sorting)' "$abi_tmp/needed" > "$abi_tmp/forbidden-deps"; then \
            echo 'ERROR: static-owned SDK core still depends on a shared client/runtime provider.' >&2; cat "$abi_tmp/forbidden-deps" >&2; exit 1; \
        fi; \
        awk '$2 == "U" || $2 == "w" || $2 == "v" { print $1 }' "$abi_tmp/undefined" > "$abi_tmp/import-names"; \
        awk '{ print $1 }' "$abi_tmp/core-defined" > "$abi_tmp/export-names"; \
        for direction in import export; do \
            c++filt < "$abi_tmp/$direction-names" > "$abi_tmp/$direction-demangled"; \
            awk '{ name=$0; sub(/^(non-virtual thunk to |virtual thunk to |covariant return thunk to |construction vtable for |typeinfo for |typeinfo name for |vtable for |VTT for |guard variable for |TLS init function for |TLS wrapper function for )/, "", name); if (name ~ /^(google::protobuf::|inference::|triton::client::|absl::|grpc::|grpc_core::|grpc_impl::|grpc_event_engine::|upb::|re2::|grpc_|gpr_|upb_|_upb_|ares_|address_sorting_|utf8_range_|utf8_validity_)/ || (name ~ /^(descriptor_table_|file_level_metadata_)/ && name !~ /^(descriptor_table_|file_level_metadata_)nvdsinferserver_/)) print $0 }' "$abi_tmp/$direction-demangled" > "$abi_tmp/$direction-leaks"; \
            if [ -s "$abi_tmp/$direction-leaks" ]; then \
                echo "ERROR: static-owned SDK core leaks upstream $direction namespace symbols; keep archive/header symbols private." >&2; cat "$abi_tmp/$direction-leaks" >&2; exit 1; \
            fi; \
        done; \
        echo 'Verified version-matched static core ownership/isolation metadata only; full runtime qualification remains required.'; \
    else \
        if [ -s "$abi_tmp/marker" ]; then echo 'ERROR: static-core marker does not match the selected legacy provider.' >&2; exit 1; fi; \
        awk '$2 == "U" && $1 ~ /^_ZN[KVRrO]*(9inference|6triton6client)/ { print $1 }' "$abi_tmp/undefined" > "$abi_tmp/imports"; \
        if [ ! -s "$abi_tmp/imports" ]; then echo 'ERROR: no strong Triton client namespace imports found; subset check cannot qualify this SDK core.' >&2; exit 1; fi; \
        nm -D -g --defined-only --format=posix "$client" > "$abi_tmp/defined"; \
        awk '{ print $1 }' "$abi_tmp/defined" > "$abi_tmp/exports"; \
        sort -u "$abi_tmp/imports" > "$abi_tmp/imports.sorted"; \
        sort -u "$abi_tmp/exports" > "$abi_tmp/exports.sorted"; \
        comm -23 "$abi_tmp/imports.sorted" "$abi_tmp/exports.sorted" > "$abi_tmp/missing"; \
        if [ -s "$abi_tmp/missing" ]; then \
            echo 'ERROR: DeepStream/Triton client-symbol subset mismatch; rebuild SDK core/plugin with the selected client provider. Missing symbols:' >&2; \
            cat "$abi_tmp/missing" >&2; exit 1; \
        fi; \
        echo 'Verified legacy Triton client-symbol subset only; full runtime qualification remains required.'; \
    fi

