# No public CUDA13.2.2 base is assumed. Supply a JetPack7.2.2-compatible image
# already provisioned with the exact Jetson stack; do not silently use13.2.1.
ARG JETSON_RUNTIME_IMAGE
FROM --platform=linux/arm64 ${JETSON_RUNTIME_IMAGE}

ARG L4T_RELEASE=r39.2
ARG DS_SDK_TARBALL=deepstream_sdk_v9.2.1_jetson.tbz2
ARG OPENTELEMETRY_CPP_VERSION=v1.23.0
ARG OPENTELEMETRY_BUILD_JOBS

ENV DS_VERSION=9.2

RUN python3 -c 'import json, sys; assert sys.version_info[:2] == (3, 12), "Jetson requires Python3.12"; assert json.load(open("/usr/local/cuda/version.json"))["cuda"]["version"] == "13.2.2", "Jetson requires CUDA13.2.2"' && \
    for spec in libnvinfer11=11.4.1.31 libcudnn9-cuda-13=9.20.0.46 libnvvpi4=4.1.6; do \
        package=${spec%%=*}; expected=${spec#*=}; actual=$(dpkg-query -W -f '${Version}' "$package"); \
        case "$actual" in "$expected"|"$expected"[-+]*) ;; \
            *) echo "Jetson requires ${package}=${expected}; found ${actual}" >&2; exit 1 ;; esac; \
    done

RUN apt-key adv --fetch-keys https://repo.download.nvidia.com/jetson/jetson-ota-public.asc

RUN echo "deb https://repo.download.nvidia.com/jetson/common ${L4T_RELEASE} main" >> /etc/apt/sources.list


RUN  apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends wget 

# GStreamer + deepstream dependencies
RUN  --mount=type=bind,src=jetson_dockerfiles,target=/tmp/docker  \
        mkdir -p /lib/firmware ; mkdir -p /root/tmp ; mkdir -p /tmp99 ; ls -ltr /root ;  \
        apt-get update && \
        DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        rsyslog git \
        tzdata \
        tar \
        ca-certificates \
        libgstrtspserver-1.0-0 \
        gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-tools \
        libgstrtspserver-1.0-0 libgstrtspserver-1.0-dev \
        libjansson4 \
        libglib2.0-dev \
        libjson-glib-1.0-0 \
        librabbitmq4 \
        gstreamer1.0-rtsp \
        libgstreamer1.0-0 \
        gstreamer1.0-tools \
        libyaml-cpp-dev \
        libjsoncpp-dev \
        libjpeg-dev \
        openssl \
        libssl3 \
        build-essential \
        libssl-dev \
        libcurl4-openssl-dev \
        libcjson-dev \
        apparmor-utils \
        libprotoc32t64 \
        libprotobuf32t64 \
        mosquitto \
        libhiredis-dev \
        librdkafka1 \
        python3-pip \
        gnupg2 \
        kmod && \
        cd /tmp && \
        rm -rf /root/tmp && \
        rm -rf /var/lib/apt/lists/* && \
        rm -rf /root/tmp && \       
        apt autoremove


# Fix Base image included only development symlinks but not the actual OpenCV runtime libraries
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libopencv-dev=4.6.0+dfsg-13.1ubuntu1 && \
    ldconfig

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y --allow-downgrades libprotobuf32t64=3.21.12-8.2ubuntu0.4 libprotoc32t64=3.21.12-8.2ubuntu0.4


# open telemetry
# Built from source instead of prebuilt .deb packages: the Debian/Ubuntu archives
# rotate opentelemetry-cpp binaries out of the pool, which breaks the docker build.
# Runs after the protobuf step so the OTLP exporters link against the same protobuf
# the image ships. Default OTELCPP_VERSIONED_LIBS=OFF and WITH_STL=OFF are required:
# prebuilt DeepStream libraries expect unversioned SONAMEs
# (libopentelemetry_metrics.so) and the nostd ABI used by includes/opentelemetry.
# CURL comes from the libcurl4-openssl-dev installed above.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      cmake \
      libgrpc++-dev \
      libprotobuf-dev=3.21.12-8.2ubuntu0.4 \
      nlohmann-json3-dev \
      protobuf-compiler \
      protobuf-compiler-grpc && \
    git clone --depth 1 --branch ${OPENTELEMETRY_CPP_VERSION} \
      https://github.com/open-telemetry/opentelemetry-cpp.git /tmp/opentelemetry-cpp && \
    git -C /tmp/opentelemetry-cpp submodule update --init --depth 1 third_party/opentelemetry-proto && \
    cmake -S /tmp/opentelemetry-cpp -B /tmp/opentelemetry-cpp/build \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib/aarch64-linux-gnu \
      -DCMAKE_CXX_STANDARD=17 \
      -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DBUILD_SHARED_LIBS=ON \
      -DOPENTELEMETRY_INSTALL=ON \
      -DWITH_OTLP_HTTP=ON \
      -DWITH_OTLP_GRPC=ON \
      -DWITH_EXAMPLES=OFF \
      -DWITH_FUNC_TESTS=OFF \
      -DWITH_BENCHMARK=OFF \
      -DBUILD_TESTING=OFF && \
    cmake --build /tmp/opentelemetry-cpp/build \
      --parallel "${OPENTELEMETRY_BUILD_JOBS:-$(nproc)}" && \
    cmake --install /tmp/opentelemetry-cpp/build && \
    rm -rf /tmp/opentelemetry-cpp && \
    DEBIAN_FRONTEND=noninteractive apt-get purge -y cmake && \
    rm -rf /var/lib/apt/lists/* && \
    ldconfig

RUN --mount=type=bind,src=jetson_dockerfiles,target=/tmp/docker \
        tar --version ; mkdir -p /root/tmp ; mkdir -p /tmp99 ; ls -ltr /root ; tar -xvf "/tmp/docker/${DS_SDK_TARBALL}" -C / && /opt/nvidia/deepstream/deepstream/install.sh && \
        cp /tmp/docker/rsyslog /etc/init.d/  && \
        chmod +x /etc/init.d/rsyslog && \
        cp /tmp/docker/libgstrtpmanager.so /tmp99/libgstrtpmanager.so && \
        cp /tmp/docker/libgstrtsp.so /tmp99/libgstrtsp.so && \
        cp /tmp/docker/libgstvideoparsersbad.so /tmp99/libgstvideoparsersbad.so && \
        ln -s /usr/lib/aarch64-linux-gnu/nvidia /usr/lib/aarch64-linux-gnu/tegra && \
        if [ -x /usr/bin/trtexec ]; then :; \
        elif [ -e /usr/bin/trtexec ] || [ -L /usr/bin/trtexec ]; then \
            echo 'Optional trtexec path exists but is not executable; leaving it unchanged.' >&2; \
        elif [ -x /usr/src/tensorrt/bin/trtexec ]; then \
            ln -s /usr/src/tensorrt/bin/trtexec /usr/bin/trtexec; \
        else echo 'Optional trtexec CLI is not installed in the supplied runtime image.' >&2; fi && \
        cp /tmp/docker/entrypoint.sh /opt/nvidia/deepstream/deepstream/ && \
        chmod +x /opt/nvidia/deepstream/deepstream/entrypoint.sh && \
        cp  /tmp/docker/user_additional_install_runtime.sh /opt/nvidia/deepstream/deepstream/ && \
        cp  /tmp/docker/LicenseAgreementContainer.pdf /opt/nvidia/deepstream/deepstream/ && \
        mv  /opt/nvidia/deepstream/deepstream/user_additional_install_runtime.sh /opt/nvidia/deepstream/deepstream/user_additional_install.sh && \
        rm -rf /var/lib/apt/lists/* && \
        rm -rf /root/tmp && \
        apt autoremove -y

# WAR for CUDA compatability so DeepStream will run without errors with JP 7.2 - 580.xx drivers
RUN apt purge -y cuda-compat-13-2 cuda-compat-orin-13-2


# Workaround for deepstream-app --version-all
RUN  ln -sfn /usr/local/cuda-13.2/lib64/libcufft.so.12 /usr/local/cuda-13.2/lib64/libcufft.so && \
     ln -sfn /usr/local/cuda-13.2/lib64/libcublas.so.13 /usr/local/cuda-13.2/lib64/libcublas.so && \
     ln -sfn /usr/lib/aarch64-linux-gnu/libcudnn.so.9 /usr/lib/aarch64-linux-gnu/libcudnn.so && \
     ln -sfn /usr/local/cuda-13.2/targets/sbsa-linux/lib/libcudart.so.13 /usr/local/cuda-13.2/targets/sbsa-linux/lib/libcudart.so

# for reference apps
RUN ln -sfn "/opt/nvidia/deepstream/deepstream-9.2/includes" "/opt/nvidia/deepstream/deepstream-9.2/sources/includes"



# IP requirement for removal
RUN rm -f /usr/lib/aarch64-linux-gnu/libavresample* /usr/lib/aarch64-linux-gnu/libavutil* \
        /usr/lib/aarch64-linux-gnu/libavcodec* /usr/lib/aarch64-linux-gnu/libavformat* \
        /usr/lib/aarch64-linux-gnu/libavfilter*
RUN rm -f /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstaudioparsers.so \
        /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstfaad.so

RUN rm -f /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstvoaacenc.so \
        /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstx264.so /usr/lib/aarch64-linux-gnu/libx264.so*  \
        /usr/lib/aarch64-linux-gnu/libmpeg2.so* /usr/lib/aarch64-linux-gnu/libmpeg2convert.so* /usr/lib/aarch64-linux-gnu/libmpeg2encpp-2.1.so* 
RUN rm -f  /usr/lib/aarch64-linux-gnu/libmpg123.so* /usr/lib/aarch64-linux-gnu/libvpx.so* /usr/lib/aarch64-linux-gnu/libx265.so*  \
        /usr/lib/aarch64-linux-gnu/libde265.so* /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstx265.so*  \
        /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstde265.so* /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstvpx.so \
        /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstopenh264.so /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstnvcodec.so \
        /usr/lib/aarch64-linux-gnu/libjbig.so* /usr/lib/aarch64-linux-gnu/libmplex2-2.1.so*

# new IP additions

RUN rm -f /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstuvch264.so /usr/lib/aarch64-linux-gnu/libopenh264.so.2.2.0 /usr/lib/aarch64-linux-gnu/libopenh264.so* \
        /usr/lib/aarch64-linux-gnu/libvo-aacenc.so.0 /usr/lib/aarch64-linux-gnu/libvo-aacenc.so.0.0.4 /usr/lib/aarch64-linux-gnu/libmp3lame.so.0.0.0 \
        /usr/lib/aarch64-linux-gnu/libmp3lame.so.0 /usr/lib/aarch64-linux-gnu/libfaad* /usr/lib/aarch64-linux-gnu/libFLAC.so* \
        /usr/lib/aarch64-linux-gnu/libmjpegutils-2.1.so.0* /usr/lib/aarch64-linux-gnu/libxvidcore.so* /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstmpegpsmux.so \
        /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstflac.so \
        /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstmpeg2enc.so /usr/lib/aarch64-linux-gnu/gstreamer-1.0/libgstmpeg2dec.so

# remove for DS 8.0 VSS
RUN rm -f /usr/lib/*-linux-gnu/libdca.so* /usr/lib/*-linux-gnu/libdvdnav.so* /usr/lib/*-linux-gnu/libdvdread.so* \
          /usr/lib/*-linux-gnu/libmpeg2.so.0* /usr/lib/*-linux-gnu/libmpeg2encpp-2.1.so* /usr/lib/*-linux-gnu/libmpg123.so*

RUN rm -f /usr/lib/aarch64-linux-gnu/libswresample.a* /usr/lib/aarch64-linux-gnu/libswresample.so*

CMD ["/bin/bash"]
WORKDIR /opt/nvidia/deepstream/deepstream


ENTRYPOINT ["/opt/nvidia/deepstream/deepstream/entrypoint.sh"]

ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/cuda-13.2/lib64:/opt/nvidia/deepstream/deepstream-9.2/lib

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all

#
RUN ldconfig

