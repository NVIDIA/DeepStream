# Explicit matching JetPack providers are required. Stock26.10/TRT11.4.0 is
# generic SBSA, not a Jetson replacement; do not swap TRT below old backends.
ARG JETSON_TRITON_IMAGE
ARG JETSON_TRITON_SDK_IMAGE
FROM --platform=linux/arm64 ${JETSON_TRITON_SDK_IMAGE} AS triton_client_sdk
FROM --platform=linux/arm64 ${JETSON_TRITON_IMAGE}

ARG L4T_RELEASE=r39.2
ARG DS_SDK_TARBALL=deepstream_sdk_v9.2.1_jetson.tbz2
ARG JETSON_TRITON_SDK_LIB_DIR=/workspace/install/lib
ARG JETSON_TRITON_SDK_INCLUDE_DIR=/workspace/install/include
ARG OPENTELEMETRY_CPP_VERSION=v1.23.0
ARG OPENTELEMETRY_BUILD_JOBS

ENV DS_VERSION=9.2

# The provider must already contain the compatible server/backends and core
# libraries. These identity checks are not functional/JetPack qualification.
RUN python3 -c 'import json, sys; assert sys.version_info[:2] == (3, 12), "Jetson requires Python3.12"; assert json.load(open("/usr/local/cuda/version.json"))["cuda"]["version"] == "13.2.2", "Jetson requires CUDA13.2.2"' && \
    for spec in libnvinfer11=11.4.1.31 libnvinfer-dev=11.4.1.31 libnvonnxparsers-dev=11.4.1.31 libcudnn9-cuda-13=9.20.0.46 libnvvpi4=4.1.6 vpi4-dev=4.1.6; do \
        package=${spec%%=*}; expected=${spec#*=}; actual=$(dpkg-query -W -f '${Version}' "$package"); \
        case "$actual" in "$expected"|"$expected"[-+]*) ;; \
            *) echo "Jetson requires ${package}=${expected}; found ${actual}" >&2; exit 1 ;; esac; \
    done && test -f /opt/tritonserver/lib/libtritonserver.so

# Configure nvidia external apt repo
#
RUN apt-key adv --fetch-keys https://repo.download.nvidia.com/jetson/jetson-ota-public.asc

