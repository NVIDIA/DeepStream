# SBSA (ARM server with discrete GPU) DeepStream Triton devel image. The same
# image runs on GB200 / Grace and on DGX Spark.
#
# Unlike Jetson, an SBSA host carries no Jetson BSP and the container runtime
# does not inject Tegra libraries at run time, so the Tegra multimedia stack is
# baked into the image from the public Jetson Linux Driver Package (BSP). See
# the SBSA section of ../README.md for the required build setup.

# NGC container release used for both the Triton runtime and SDK images.
ARG TRITON_NGC_VERSION=26.10
ARG TRITON_SDK_IMAGE=nvcr.io/nvidia/tritonserver:${TRITON_NGC_VERSION}-py3-sdk
ARG TRITON_RUNTIME_IMAGE=nvcr.io/nvidia/tritonserver:${TRITON_NGC_VERSION}-py3

# This Dockerfile is SBSA-only; Docker uses linux/arm64 for aarch64 images.
FROM --platform=linux/arm64 ${TRITON_SDK_IMAGE} AS triton_client_sdk

FROM --platform=linux/arm64 ${TRITON_RUNTIME_IMAGE}

# BuildKit populates TARGETARCH from docker build --platform.
ARG TARGETARCH
ARG DS_SDK_TARBALL=deepstream_sdk_v9.2.1_sbsa.tbz2

# Jetson Linux release that supplies the Tegra BSP and the GStreamer plugins.
# Keep this in step with the BSP tarball staged by setup_sbsa_build.sh.
ARG L4T_RELEASE=r39.2

# Genuine discrete-GPU SBSA VPI4.1.6 inputs must be supplied explicitly.
# Do not relabel the old public4.1.3 inputs or use Jetson Tegra-linked binaries.
ARG VPI_VERSION=4.1.6
ARG VPI_LIB_URL
ARG VPI_DEV_URL
ARG VPI_LIB_SHA256
ARG VPI_DEV_SHA256

ARG OPENTELEMETRY_CPP_VERSION=v1.23.0
ARG OPENTELEMETRY_BUILD_JOBS

ENV DS_VERSION=9.2

# No reviewed public4.1.6 SBSA provider is assumed by this recipe.
RUN test "${VPI_VERSION}" = 4.1.6 && test -n "${VPI_LIB_URL}" && test -n "${VPI_DEV_URL}" && \
    printf '%s\n%s\n' "${VPI_LIB_SHA256}" "${VPI_DEV_SHA256}" | grep -Evc '^[0-9a-f]{64}$' | grep -qx 0 || \
    { echo 'Supply genuine SBSA VPI4.1.6 VPI_LIB_URL/VPI_DEV_URL and SHA256 build arguments.' >&2; exit 1; }

# =============================================================================
# INITIAL SETUP AND PACKAGE EXTRACTION
# =============================================================================

# /root/tmp is used to copy scripts into while creating docker
RUN mkdir -p /tmp/scripts && \
    mkdir -p /root/tmp && \
    ls -lah /tmp

# Unpack the Tegra multimedia stack out of the staged Jetson Linux BSP. Bind
# mounting keeps the multi-GB BSP tarball out of the image layers.
RUN --mount=type=bind,src=sbsa_dockerfiles,target=/tmp/docker \
    set -eu; \
    ls -lah /tmp/docker; \
    bsp_count=$(ls -1 /tmp/docker/Jetson_Linux_R*_aarch64.tbz2 2>/dev/null | wc -l); \
    if [ "$bsp_count" -eq 0 ]; then \
        echo "error: no Jetson_Linux_R*_aarch64.tbz2 in the build context." >&2; \
        echo "       Stage the Jetson Linux Driver Package (BSP) with setup_sbsa_build.sh." >&2; \
        exit 1; \
    elif [ "$bsp_count" -gt 1 ]; then \
        echo "error: multiple Jetson_Linux_R*_aarch64.tbz2 in the build context; keep only one." >&2; \
        ls -1 /tmp/docker/Jetson_Linux_R*_aarch64.tbz2 >&2; \
        exit 1; \
    fi; \
    /tmp/docker/extract_packages.sh "$(ls -1 /tmp/docker/Jetson_Linux_R*_aarch64.tbz2)"

